{
  "hosting": {
    "public": "build",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
      ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
